BUNDLE_ID=nl.rvt.gatas.GaTasCompanion
// Shared product and home-screen display name for the iPhone app.
APP_NAME=GatasCompanion
PRODUCT_BUNDLE_IDENTIFIER=$(BUNDLE_ID)
DEVELOPMENT_TEAM=$(TEAM_ID)
IPHONEOS_DEPLOYMENT_TARGET=18.0
WATCHOS_DEPLOYMENT_TARGET=10.0
// The Kotlin framework provides an Apple silicon simulator slice only.
EXCLUDED_ARCHS[sdk=iphonesimulator*]=x86_64
#include "../../Version.xcconfig"
// Keep signing overrides in a local, ignored file.
// Copy Config.local.xcconfig.example to Config.local.xcconfig and set TEAM_ID there.
#include? "Config.local.xcconfig"
